+// Pure pairing checks copied from the current required-membership validator.
+// The original validator and real-purchase behavior are not changed.
+use std::collections::BTreeMap;
+
+/// Lead Dev Nicolas. Static approval scope, not vendor or future-product discovery.
+const EQUIPMENT_PRODUCTS: [&str; 5] = [
+    "gid://shopify/Product/15489196359779",
+    "gid://shopify/Product/15489196392547",
+    "gid://shopify/Product/15489196425315",
+    "gid://shopify/Product/15489196458083",
+    "gid://shopify/Product/15489196490851",
+];
+
+/// Exact (product, variant) pairs in Primal, never Echelon catalog identifiers.
+const PLANS: [(&str, &str); 3] = [
+    (
+        "gid://shopify/Product/15492256596067",
+        "gid://shopify/ProductVariant/67964183445603",
+    ),
+    (
+        "gid://shopify/Product/15492256628835",
+        "gid://shopify/ProductVariant/67964183478371",
+    ),
+    (
+        "gid://shopify/Product/15492256661603",
+        "gid://shopify/ProductVariant/67964183511139",
+    ),
+];
+
+#[derive(Clone, Copy)]
+pub(super) struct Line<'a> {
+    pub(super) variant: &'a str,
+    pub(super) product: &'a str,
+    pub(super) quantity: i32,
+    pub(super) offer: Option<&'a str>,
+    pub(super) related: Option<&'a str>,
+    pub(super) main: Option<&'a str>,
+    pub(super) bundle: Option<&'a str>,
+    pub(super) annual: Option<&'a str>,
+}
+
+struct Equipment<'a> {
+    product: &'a str,
+    quantity: i64,
+    member_quantity: i64,
+    offered_plans: u8,
+}
+
+/// Private Ajax attributes must be canonical numeric variant IDs. Do not coerce
+/// arbitrary strings, GIDs, whitespace, leading zeros or partially parsed IDs.
+fn numeric_id(value: &str) -> Option<&str> {
+    if value.is_empty() || value.starts_with('0') || !value.bytes().all(|b| b.is_ascii_digit()) {
+        return None;
+    }
+    value.parse::<u64>().ok().filter(|id| *id > 0)?;
+    Some(value)
+}
+
+fn gid_numeric<'a>(value: &'a str, prefix: &str) -> Option<&'a str> {
+    numeric_id(value.strip_prefix(prefix)?)
+}
+
+/// Parse the entire list.product_reference value, not quoted-ID substrings.
+/// A missing/empty/malformed value, mixed JSON types or invalid GIDs fails closed.
+fn offered_plans(value: Option<&str>) -> Option<u8> {
+    let products: Vec<String> = serde_json::from_str(value?).ok()?;
+    if products.is_empty()
+        || products
+            .iter()
+            .any(|id| gid_numeric(id, "gid://shopify/Product/").is_none())
+    {
+        return None;
+    }
+    let mask = PLANS
+        .iter()
+        .enumerate()
+        .fold(0, |mask, (index, (product, _))| {
+            mask | if products.iter().any(|id| id == product) {
+                1 << index
+            } else {
+                0
+            }
+        });
+    (mask != 0).then_some(mask)
+}
+
+/// Validate the resulting cart, never the order of an attempted change. This
+/// applies in every buyerJourney step. Empty carts and atomic pair removals can
+/// repair old invalid carts without a CART_INTERACTION bypass.
+pub(super) fn valid_cart(lines: &[Line<'_>]) -> bool {
+    let mut equipment: BTreeMap<&str, Equipment<'_>> = BTreeMap::new();
+
+    // First pass groups equipment across distinct cart lines by actual variant.
+    for line in lines {
+        if !EQUIPMENT_PRODUCTS.contains(&line.product) {
+            continue;
+        }
+        let Some(variant) = gid_numeric(line.variant, "gid://shopify/ProductVariant/") else {
+            return false;
+        };
+        if line.quantity <= 0 || PLANS.iter().any(|(_, id)| *id == line.variant) {
+            return false;
+        }
+        let Some(mask) = offered_plans(line.offer) else {
+            return false;
+        };
+        let group = equipment.entry(variant).or_insert(Equipment {
+            product: line.product,
+            quantity: 0,
+            member_quantity: 0,
+            offered_plans: mask,
+        });
+        if group.product != line.product {
+            return false;
+        }
+        group.offered_plans &= mask;
+        let Some(quantity) = group.quantity.checked_add(i64::from(line.quantity)) else {
+            return false;
+        };
+        group.quantity = quantity;
+    }
+
+    // Any known membership product OR variant is in scope, preventing a wrong
+    // product/variant combination from being silently treated as unrelated.
+    for line in lines {
+        if !PLANS
+            .iter()
+            .any(|(product, variant)| *product == line.product || *variant == line.variant)
+        {
+            continue;
+        }
+        let Some(plan_index) = PLANS
+            .iter()
+            .position(|(product, variant)| *product == line.product && *variant == line.variant)
+        else {
+            return false;
+        };
+        if line.quantity <= 0 {
+            return false;
+        }
+        let Some(own_variant) = gid_numeric(line.variant, "gid://shopify/ProductVariant/") else {
+            return false;
+        };
+        if line.main != Some(own_variant) || line.bundle != Some(own_variant) {
+            return false;
+        }
+        let Some(related) = line.related.and_then(numeric_id) else {
+            return false;
+        };
+        if line.annual != Some(related) {
+            return false;
+        }
+        let Some(group) = equipment.get_mut(related) else {
+            return false;
+        };
+        if group.offered_plans & (1 << plan_index) == 0 {
+            return false;
+        }
+        let Some(quantity) = group.member_quantity.checked_add(i64::from(line.quantity)) else {
+            return false;
+        };
+        group.member_quantity = quantity;
+    }
+
+    equipment
+        .values()
+        .all(|group| group.quantity == group.member_quantity)
+}
