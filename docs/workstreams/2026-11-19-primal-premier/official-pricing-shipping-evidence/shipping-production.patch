+mod required_pairing;
+const STRIDE_PRODUCT_ID: &str = "gid://shopify/Product/15489196458083";
+const STRIDE_VARIANT_ID: &str = "gid://shopify/ProductVariant/67950451818595";
+
+// This exception is enabled only by the existing, exact approved configuration.
+// Do not globally allow Monthly, infer IDs, or treat missing config as approval.
+fn approved_stride_configuration(object: &std::collections::BTreeMap<String, JsonValue>) -> bool {
+    fn exact(values: Option<&JsonValue>, approved: &[&str]) -> bool {
+        let Some(JsonValue::Array(values)) = values else {
+            return false;
+        };
+        values.len() == approved.len()
+            && approved.iter().all(|id| {
+                values
+                    .iter()
+                    .filter(|value| matches!(value, JsonValue::String(value) if value == id))
+                    .count()
+                    == 1
+            })
+    }
+    exact(
+        object.get("eligibleProductOrVariantIds"),
+        &[
+            "gid://shopify/Product/15492256628835",
+            "gid://shopify/Product/15492256661603",
+        ],
+    ) && exact(
+        object.get("excludedProductOrVariantIds"),
+        &[
+            MONTHLY_PRODUCT_ID,
+            "gid://shopify/ProductVariant/67964183445603",
+        ],
+    )
+}
