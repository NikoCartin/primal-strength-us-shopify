<div class="product-block-box quote-bulk-order-block product-block-item">
  {% render 'load-css', stylesheet: 'component-popup-form', inline: true %}
  {%- render 'load-js', script: 'popup-form.min' -%}
  {%- render 'load-js', script: 'bulk-order-initialise.min' -%}

  {% comment %} Custom Quote  {% endcomment %}
  {% if custom == true %}
    <div class="quote-header">
      {% render 'icon-quote' %}
      <h2 class="quote-header-title eyebrow-md snug-heading">{{ block.settings.custom_heading }}</h2>
      <button
        aria-haspopup="dialog"
        aria-controls="pdp-quote-form"
        aria-expanded="false"
        class="button button-quaternary  button-quaternary--light button-md button-primary--outline button--custom-order snug-text"
      >
        <span class="button-text">
          {{ block.settings.custom_cta }}
        </span>
      </button>
    </div>

    {% if block.settings.custom_description != blank %}
      <div class="quote-description body-md snug-text">
        {{ block.settings.custom_description }}
      </div>
    {% endif %}

    <div class="custom-form__wrapper background--smoke">
      <h3 class="text-center">{{ block.settings.custom_cta }}</h3>
      <div
        class="customForm__close-btn"
        role="button"
        tabindex="0"
        aria-label="Close {{ block.settings.custom_cta }} form"
      >
        {% render 'icon-close' %}
      </div>

      {% if block.settings.custom_hs != blank %}
        {{ block.settings.custom_hs }}
      {% else %}
        {%- comment -%} Formspree quote request form {%- endcomment -%}
        <style>
          .pdp-quote-formspree {
            display: flex;
            flex-direction: column;
            gap: 16px;
            width: 100%;
          }
          .pdp-quote-formspree .form-row {
            display: flex;
            gap: 16px;
          }
          .pdp-quote-formspree .form-row .field-group {
            flex: 1;
          }
          .pdp-quote-formspree .field-group {
            display: flex;
            flex-direction: column;
            width: 100%;
          }
          .pdp-quote-formspree input,
          .pdp-quote-formspree textarea {
            width: 100%;
            padding: 16px 20px;
            border: 1px solid #e5e7eb;
            border-radius: 6px;
            background-color: #fcfcfd;
            font-size: 14px;
            color: #333;
            box-sizing: border-box;
            outline: none;
            transition: border-color 0.2s ease;
            font-family: inherit;
          }
          .pdp-quote-formspree input:focus,
          .pdp-quote-formspree textarea:focus {
            border-color: #999;
          }
          .pdp-quote-formspree input::placeholder,
          .pdp-quote-formspree textarea::placeholder {
            color: #6b7280;
          }
          .pdp-quote-formspree textarea {
            resize: vertical;
            min-height: 120px;
          }
          .pdp-quote-formspree .submit-btn {
            align-self: flex-start;
            padding: 12px 32px;
            background-color: transparent;
            color: #000;
            border: 1px solid #000;
            border-radius: 30px;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            cursor: pointer;
            letter-spacing: 0.5px;
            transition: background-color 0.2s ease, color 0.2s ease;
            margin-top: 8px;
            font-family: inherit;
          }
          .pdp-quote-formspree .submit-btn:hover {
            background-color: #000;
            color: #fff;
          }
          .pdp-quote-formspree .form-success {
            display: none;
            padding: 16px;
            background: #f0fdf4;
            border: 1px solid #bbf7d0;
            border-radius: 6px;
            color: #166534;
            font-size: 14px;
          }
          @media screen and (max-width: 749px) {
            .pdp-quote-formspree .form-row {
              flex-direction: column;
            }
          }
        </style>

        <form
          class="pdp-quote-formspree"
          action="https://formspree.io/f/xrendkpy"
          method="POST"
          id="pdp-custom-quote-form"
        >
          {%- comment -%} Honeypot spam trap {%- endcomment -%}
          <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off">
          {%- comment -%} Hidden context fields {%- endcomment -%}
          <input type="hidden" name="_subject" value="Product Quote Request — {{ product.title }}">
          <input type="hidden" name="Product" value="{{ product.title }}">
          <input type="hidden" name="Product SKU" value="{{ product.selected_or_first_available_variant.sku }}">
          <input type="hidden" name="Product URL" value="{{ shop.url }}{{ product.url }}">
          <input type="hidden" name="Source" value="PDP Custom Quote">

          <div class="form-row">
            <div class="field-group">
              <input type="text" name="Name" placeholder="Name *" required>
            </div>
            <div class="field-group">
              <input type="email" name="Email" placeholder="Email *" required>
            </div>
          </div>

          <div class="form-row">
            <div class="field-group">
              <input type="tel" name="Phone" placeholder="Phone *" required>
            </div>
            <div class="field-group">
              <input type="number" name="Quantity Required" placeholder="Quantity required *" min="1" required>
            </div>
          </div>

          <div class="field-group">
            <input type="text" name="Company / Gym Name" placeholder="Company / Gym Name *" required>
          </div>

          <div class="field-group">
                <div class="field">
    <input class="field__input" type="url" id="primal-snippets-quote-bulk-order-liquid-1-website" name="website" placeholder="Website (optional)" autocomplete="url">
    <label class="field__label" for="primal-snippets-quote-bulk-order-liquid-1-website">Website</label>
  </div>
<div class="field market-segment-field">
    <label class="field__label" for="pdp-custom-quote-form-market-segment">Market Segment</label>
    <select class="field__input" id="pdp-custom-quote-form-market-segment" name="market_segment" required aria-required="true">
      <option value="">Select a market segment</option>
      <option value="Clubs">Clubs</option>
      <option value="Corporate Office">Corporate Office</option>
      <option value="Education">Education</option>
      <option value="Enterprise Corporate Wellness">Enterprise Corporate Wellness</option>
      <option value="Enterprise Fitness">Enterprise Fitness</option>
      <option value="Federal Government">Federal Government</option>
      <option value="Fitness">Fitness</option>
      <option value="Healthcare">Healthcare</option>
      <option value="Higher Education">Higher Education</option>
      <option value="Home">Home</option>
      <option value="Hospitality">Hospitality</option>
      <option value="International">International</option>
      <option value="Local Government">Local Government</option>
      <option value="Multifamily">Multifamily</option>
      <option value="Recreation">Recreation</option>
      <option value="Sports">Sports</option>
      <option value="Sports Performance">Sports Performance</option>
      <option value="YMCA & Non-Profit">YMCA & Non-Profit</option>
    </select>
  </div>
<textarea name="Message" placeholder="Additional information or requirements"></textarea>
          </div>

          <div class="form-success" id="pdp-quote-success">
            Thank you! Your quote request has been received. A member of our team will be in touch shortly.
          </div>

          <button type="submit" class="submit-btn">
            {{ block.settings.custom_cta | default: 'Get a Quote' }}
          </button>
        </form>

        <script>
          (function () {
            var form = document.getElementById('pdp-custom-quote-form');
            if (!form) return;

            // ── Dynamic SKU update on variant change ──────────────────────
            // Shopify fires a custom event 'variant:changed' or updates the
            // [data-sku] element when the variant selector changes.
            function updateQuoteFormVariant() {
              // Read the currently selected SKU from the PDP SKU display element
              var skuEl = document.querySelector('[data-sku]');
              var titleEl = document.querySelector('.product-title');
              var skuInput = form.querySelector('input[name="Product SKU"]');
              var titleInput = form.querySelector('input[name="Product"]');
              var subjectInput = form.querySelector('input[name="_subject"]');

              if (skuEl && skuInput) {
                var sku = skuEl.getAttribute('data-sku') || skuEl.textContent.replace('SKU:', '').trim();
                skuInput.value = sku;
              }
              if (titleEl && titleInput) {
                var title = titleEl.textContent.trim();
                titleInput.value = title;
                if (subjectInput) subjectInput.value = 'Product Quote Request \u2014 ' + title;
              }
            }

            // Listen for Shopify variant change events
            document.addEventListener('variant:changed', updateQuoteFormVariant);
            // Also observe the data-sku attribute for mutations (fallback)
            var skuEl = document.querySelector('[data-sku]');
            if (skuEl && window.MutationObserver) {
              new MutationObserver(updateQuoteFormVariant).observe(skuEl, {
                attributes: true,
                attributeFilter: ['data-sku'],
                childList: true,
                subtree: true,
                characterData: true
              });
            }
            // ─────────────────────────────────────────────────────────────
            form.addEventListener('submit', function (e) {
              e.preventDefault();
              var data = new FormData(form);
              fetch(form.action, {
                method: 'POST',
                body: data,
                headers: { Accept: 'application/json' }
              })
                .then(function (response) {
                  if (response.ok) {
                    form.querySelectorAll('.form-row, .field-group, .submit-btn').forEach(function (el) {
                      el.style.display = 'none';
                    });
                    document.getElementById('pdp-quote-success').style.display = 'block';
                  } else {
                    alert('There was a problem submitting your request. Please try again or contact us directly.');
                  }
                })
                .catch(function () {
                  alert('There was a problem submitting your request. Please try again or contact us directly.');
                });
            });
          })();
        </script>
      {% endif %}
    </div>

  {% elsif product.tags contains 'Buying in bulk' %}
    {% comment %} Bulk Quote  {% endcomment %}
    <div class="quote-header">
      {% render 'icon-box' %}
      <h2 class="quote-header-title eyebrow-md snug-heading">{{ block.settings.bulk_heading }}</h2>
      <button
        aria-haspopup="dialog"
        aria-controls="pdp-quote-form"
        aria-expanded="false"
        class="button button-quaternary  button-quaternary--light button-md button-primary--outline button--bulk-order snug-text"
      >
        <span class="button-text">
          {{ block.settings.bulk_cta }}
        </span>
      </button>
    </div>

    {% if block.settings.bulk_description != blank %}
      <div class="quote-description body-md snug-text">
        {{ block.settings.bulk_description }}
      </div>
    {% endif %}

    {% for variant in product.variants %}
      {% if variant.metafields.custom.bulk_ordering != blank %}
        <div
          class="quote-pricing {% if product.selected_or_first_available_variant.id == variant.id %}active{% endif %}"
          data-variant="{{ variant.id }}"
        >
          {% for bulk_price in variant.metafields.custom.bulk_ordering.value %}
            {% comment %} Metafield formatted as 1-4 = £3,995 for each line  {% endcomment %}
            {% comment %} Use the = to split between quantities/price  {% endcomment %}
            {% assign parts = bulk_price | split: '=' %}
            <div class="quote-price">
              <span class="quote-price--quantity body-md snug-text">{{ parts[0] | strip }}</span>
              <span class="quote-price--price body-md snug-text">{{ parts[1] | strip }}</span>
            </div>
          {% endfor %}
        </div>
      {% endif %}
    {% endfor %}

    <div class="contact-form__wrapper background--smoke" id="pdp-quote-form" role="dialog">
      <h3 class="text-center">{{ block.settings.bulk_cta }}</h3>
      <div
        class="form__close-btn"
        role="button"
        tabindex="0"
        aria-label="Close {{ block.settings.bulk_cta }} form"
      >
        {% render 'icon-close' %}
      </div>

      {% if block.settings.bulk_hs != blank %}
        {{ block.settings.bulk_hs }}
      {% else %}
        {% render 'contact-form', show_source: true, product: product, source: 'PDP Bulk quote' %}
      {% endif %}
    </div>

  {% else %}
    {% comment %} Request a quote  {% endcomment %}
    <div class="quote-header">
      {% render 'icon-quote' %}
      <h2 class="quote-header-title eyebrow-md snug-heading">{{ block.settings.quote_heading }}</h2>
      <button
        aria-haspopup="dialog"
        aria-controls="pdp-quote-form"
        aria-expanded="false"
        class="button button-quaternary  button-quaternary--light button-md button-primary--outline button--custom-order snug-text"
      >
        <span class="button-text">
          {{ block.settings.quote_cta }}
        </span>
      </button>
    </div>

    {% if block.settings.quote_description != blank %}
      <div class="quote-description body-md snug-text">
        {{ block.settings.quote_description }}
      </div>
    {% endif %}

    <div class="custom-form__wrapper background--smoke" id="pdp-quote-form" role="dialog">
      <h3 class="text-center">{{ block.settings.quote_cta }}</h3>
      <div
        class="customForm__close-btn"
        role="button"
        tabindex="0"
        aria-label="Close {{ block.settings.quote_cta }} form"
      >
        {% render 'icon-close' %}
      </div>

      {% if block.settings.quote_hs != blank %}
        {{ block.settings.quote_hs }}
      {% else %}
        {% render 'contact-form', show_source: true, product: product, source: 'PDP Request quote' %}
      {% endif %}
    </div>
  {% endif %}
</div>
