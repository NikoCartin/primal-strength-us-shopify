{%- assign form_id = 'LeasingInquiryForm' -%}

<div class="leasing-form-logo">
  <img
    src="https://cdn.shopify.com/s/files/1/0583/1390/0131/files/nqnsa3wc_800x800.png?v=1785258245"
    alt="Primal Strength"
    width="300"
    height="108"
    loading="lazy"
  >
</div>

<form
  id="{{ form_id }}"
  action="https://formspree.io/f/xdaqyvop"
  method="POST"
  class="isolate"
  novalidate="novalidate"
>

  <div id="{{ form_id }}-success" style="display:none;" class="form-status form__message h5" role="status" aria-live="polite">
    {%- render 'icon-success' -%}
    Thank you for your inquiry. Our team will be in touch shortly.
  </div>

  <div class="leasing-grid">

    <div class="field">
      <input
        class="field__input"
        autocomplete="given-name"
        type="text"
        id="{{ form_id }}-firstname"
        name="first_name"
        placeholder="First name"
        required
        aria-required="true"
      >
      <label class="field__label" for="{{ form_id }}-firstname">
        First name <span aria-hidden="true">*</span>
      </label>
    </div>

    <div class="field">
      <input
        class="field__input"
        autocomplete="family-name"
        type="text"
        id="{{ form_id }}-lastname"
        name="last_name"
        placeholder="Last name"
        required
        aria-required="true"
      >
      <label class="field__label" for="{{ form_id }}-lastname">
        Last name <span aria-hidden="true">*</span>
      </label>
    </div>

  </div>

  <div class="field">
    <input
      class="field__input"
      autocomplete="email"
      type="email"
      id="{{ form_id }}-email"
      name="email"
      spellcheck="false"
      autocapitalize="off"
      placeholder="Email"
      required
      aria-required="true"
    >
    <label class="field__label" for="{{ form_id }}-email">
      Email <span aria-hidden="true">*</span>
    </label>
  </div>

  <div class="field">
    <input
      class="field__input"
      autocomplete="tel"
      type="tel"
      id="{{ form_id }}-phone"
      name="phone"
      inputmode="tel"
      pattern="[0-9\-]*"
      placeholder="Phone number"
      required
      aria-required="true"
    >
    <label class="field__label" for="{{ form_id }}-phone">
      Phone number <span aria-hidden="true">*</span>
    </label>
  </div>

  <div class="field">
    <select
      id="{{ form_id }}-customer-type"
      name="customer_type"
      class="field__input select__select"
      required
      aria-required="true"
    >
      <option value="" disabled selected>What type of gym are you buying for?</option>
      <option value="Commercial Gym">Commercial Gym</option>
      <option value="Home Gym">Home Gym</option>
      <option value="Hotel / Hospitality">Hotel / Hospitality</option>
      <option value="Corporate / Office">Corporate / Office</option>
      <option value="Education / School">Education / School</option>
      <option value="Other">Other</option>
    </select>
    <label class="field__label" for="{{ form_id }}-customer-type">
      Customer Type <span aria-hidden="true">*</span>
    </label>
  </div>

  <div class="field">
    <input
      class="field__input"
      type="text"
      id="{{ form_id }}-company"
      name="company"
      placeholder="Company name"
    >
    <label class="field__label" for="{{ form_id }}-company">Company name</label>
  </div>

  <div class="field">
        <div class="field">
    <input class="field__input" type="url" id="primal-snippets-leasing-inquiry-form-liquid-1-website" name="website" placeholder="Website (optional)" autocomplete="url">
    <label class="field__label" for="primal-snippets-leasing-inquiry-form-liquid-1-website">Website</label>
  </div>
<div class="field market-segment-field">
    <label class="field__label" for="{{form_id}}-market-segment">Market Segment</label>
    <select class="field__input" id="{{form_id}}-market-segment" name="market_segment" required aria-required="true">
      <option value="">Select a market segment</option>
      <option value="Clubs">Clubs</option>
      <option value="Corporate Office">Corporate Office</option>
      <option value="Education">Education</option>
      <option value="Enterprise Corporate Wellness">Enterprise Corporate Wellness</option>
      <option value="Enterprise Fitness">Enterprise Fitness</option>
      <option value="Federal Government">Federal Government</option>
      <option value="Fitness">Fitness</option>
      <option value="Healthcare">Healthcare</option>
      <option value="Higher Education">Higher Education</option>
      <option value="Home">Home</option>
      <option value="Hospitality">Hospitality</option>
      <option value="International">International</option>
      <option value="Local Government">Local Government</option>
      <option value="Multifamily">Multifamily</option>
      <option value="Recreation">Recreation</option>
      <option value="Sports">Sports</option>
      <option value="Sports Performance">Sports Performance</option>
      <option value="YMCA & Non-Profit">YMCA & Non-Profit</option>
    </select>
  </div>
<textarea
      rows="6"
      id="{{ form_id }}-message"
      class="text-area field__input"
      name="message"
      placeholder="Message"
      required
      aria-required="true"
    ></textarea>
    <label class="form__label field__label" for="{{ form_id }}-message">
      Message <span aria-hidden="true">*</span>
    </label>
  </div>

  <input type="hidden" name="_subject" value="New Leasing Inquiry - Primal Strength US">
  <input type="hidden" name="form_source" value="Leasing Page">
  <input type="hidden" name="page_url" value="{{ canonical_url }}">
  <input type="text" name="_gotcha" style="display:none">

  <div class="contact__button" style="margin-top: 24px;">
    <button type="submit" class="button button-secondary button-secondary--light">
      Submit Inquiry
    </button>
  </div>

</form>

<style>
  .leasing-form-logo {
    margin-bottom: 24px;
  }
  .leasing-form-logo img {
    display: block;
    max-width: 300px;
    height: auto;
  }
  .leasing-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .leasing-grid .field {
    margin: 0;
  }
  @media screen and (max-width: 749px) {
    .leasing-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  (function () {
    var formId = '{{ form_id }}';
    var form = document.getElementById(formId);
    if (!form) return;

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var submitBtn = form.querySelector('[type="submit"]');
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';

      fetch('https://formspree.io/f/xdaqyvop', {
        method: 'POST',
        body: new FormData(form),
        headers: { 'Accept': 'application/json' }
      })
        .then(function (response) {
          if (response.ok) {
            form.style.display = 'none';
            var success = document.getElementById(formId + '-success');
            if (success) {
              success.style.display = 'block';
              success.focus();
            }
          } else {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Submit Inquiry';
            alert('There was an error submitting the form. Please try again.');
          }
        })
        .catch(function () {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Submit Inquiry';
          alert('There was an error submitting the form. Please try again.');
        });
    });
  })();
</script>
