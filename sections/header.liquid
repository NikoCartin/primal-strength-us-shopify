{% render 'load-css', stylesheet: 'header', preload: true %}
{% render 'load-css', stylesheet: 'component-search', defer: true %}
{% render 'load-css', stylesheet: 'component-cart-notification', inline: true %}

<style>
  .header-logo-image {
    display: block;
    width: auto;
    max-width: 200px;
    height: auto;
    object-fit: contain;
  }

  .header-logo-svg svg {
    display: block;
    width: 200px;
    max-width: 100%;
    height: auto;
  }

  .header-logo-text {
    display: block;
    font-size: 20px;
    line-height: 1;
  }

  @media screen and (max-width: 749px) {
    .header-logo-image,
    .header-logo-svg svg {
      max-width: 160px;
    }
  }

  .header-logo--brand-split {
    position: relative !important;
    display: inline-block !important;
    pointer-events: auto !important;
  }

  .header-logo__brand-link {
    position: absolute !important;
    top: 0 !important;
    bottom: 0 !important;
    display: block !important;
    pointer-events: auto !important;
    z-index: 5 !important;
  }

  .header-logo__brand-link--echelon {
    left: 0 !important;
    right: auto !important;
    width: 49.7% !important;
  }

  .header-logo__brand-link--primal {
    right: 0 !important;
    left: auto !important;
    width: 50.3% !important;
  }

  .header-logo__brand-link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }
</style>

{%- if settings.predictive_search_enabled -%}
  {% render 'load-css', stylesheet: 'component-price', inline: true, defer: true %}
  {% render 'load-css', stylesheet: 'component-loading-overlay', inline: true, defer: true %}
{%- endif -%}

