<gaia-header class="header--top transparent-header page-width">
  <header>
    <gaia-mobile-menu>
      <details
        aria-label="{{ 'sections.header.open_main_menu' | t }}"
        id="Details-Menu"
      >
        <summary
          class="menu-icon-link"
          aria-controls="mobile-menu"
          aria-label="{{ 'sections.header.menu' | t }}"
          role="button"
        >
          {%- render 'icon-hamburger' -%}
          {%- render 'icon-close' -%}
        </summary>

        <nav class="mobile-menu">
          {%- render 'component-mobile-menu', menu: section.settings.menu_left.links -%}
        </nav>
      </details>
    </gaia-mobile-menu>

    {% if section.settings.logo_svg != blank %}

      <div class="header-logo header-logo--brand-split">
        <div class="header-logo-svg">
          {{ section.settings.logo_svg }}
        </div>
        <a
          href="https://echelonfit.com/"
          aria-label="Echelon home"
          class="header-logo__brand-link header-logo__brand-link--echelon"
        ></a>
        <a
          href="{{ routes.root_url }}"
          aria-label="Visit Primal Strength US"
          class="header-logo__brand-link header-logo__brand-link--primal"
        ></a>
      </div>

    {% else %}

      <a
        href="{{ routes.root_url }}"
        aria-label="{{ shop.name | escape }}"
        class="header-logo"
      >
        {% if section.settings.logo != blank %}

          {{
            section.settings.logo
            | image_url: width: 800
            | image_tag:
              class: 'header-logo-image',
              alt: shop.name,
              widths: '100, 150, 200, 250, 300, 400, 500, 600, 800',
              loading: 'eager'
          }}

        {% elsif shop.logo != blank %}

          {% render
            'image',
            image: shop.logo,
            alt: shop.name,
            class: 'header-logo-image'
          %}

        {% else %}

          <span class="header-logo-text">
            {{ shop.name }}
          </span>

        {% endif %}
      </a>

    {% endif %}

    {%- if section.settings.menu_left != blank -%}
      <nav
        class="header-left"
        aria-label="{{ 'sections.header.left_main_menu' | t }}"
      >
        {%- render 'component-menu', menu: section.settings.menu_left.links -%}
      </nav>
    {%- endif -%}

    <nav
      class="header-right"
      aria-label="{{ 'sections.header.right_main_menu' | t }}"
    >
      <ul class="menu-icons">

        <li class="search">
          {%- render 'predictive-search' -%}
        </li>

        {% if section.settings.enable_localisation %}
          <li class="header-localisation icon-hide-mobile">
            {% render 'localisation-selector' %}
          </li>
        {% endif %}

        <li class="icon-hide-mobile">
          <a
            href="{{ routes.account_login_url }}"
            class="menu-icon-link"
            aria-label="
              {% if customer %}
                {{ 'customer.account.title' | t }}
              {% else %}
                {{ 'customer.log_in' | t }}
              {% endif %}
            "
          >
            {%- render 'icon-account' -%}
          </a>
        </li>

        {% if section.settings.wishlist %}
          <li>
            <a
              href="/pages/gym-list"
              class="swym-wishlist swym-wishlist-access"
              aria-label="{{ 'customer.my_wishlist' | t }}"
            >
              {% render 'icon-wishlist' %}
            </a>

            <script>
              (function () {
                'use strict';

                var el = document.querySelector('.swym-wishlist-access');
                var pendingUpdate = false;

                function updateDisplay(swat) {
                  if (!el) return;

                  swat.fetch(function (products) {
                    el.classList.toggle(
                      'swym-wishlist--has-items',
                      products && products.length > 0
                    );
                  });
                }

                function scheduleUpdate(swat) {
                  if (pendingUpdate) return;

                  pendingUpdate = true;

                  requestAnimationFrame(function () {
                    updateDisplay(swat);
                    pendingUpdate = false;
                  });
                }

                function initHeaderIcon(swat) {
                  updateDisplay(swat);

                  if (swat && swat.evtLayer) {
                    swat.evtLayer.addEventListener(
                      'sw:addedtowishlist',
                      function () {
                        scheduleUpdate(swat);
                      }
                    );

                    swat.evtLayer.addEventListener(
                      'sw:removedfromwishlist',
                      function () {
                        scheduleUpdate(swat);
                      }
                    );
                  }
                }

                window.SwymCallbacks = window.SwymCallbacks || [];
                window.SwymCallbacks.push(initHeaderIcon);
              })();
            </script>
          </li>
        {% endif %}

        <li>
          <a
            href="{{ routes.cart_url }}"
            class="header__icon header__icon--cart menu-icon-link"
            id="cart-icon-bubble"
            aria-controls="CartDrawer"
            role="button"
            aria-haspopup="dialog"
            aria-labelledby="cart-label"
          >
            {%- liquid
              render 'icon-cart'
            -%}

            <span id="cart-label" class="visually-hidden">
              {{- 'sections.header.view_cart' | t }}

              {%- if cart != empty -%}
                {{ 'sections.header.cart_count' | t: count: cart.item_count }}
              {% endif -%}
            </span>

            <span class="visually-hidden">
              {{ 'templates.cart.cart' | t }}
            </span>

            {%- if cart != empty -%}
              <div class="cart-count-bubble">

                {%- if cart.item_count < 100 -%}
                  <span
                    aria-hidden="true"
                    class="visually-hidden"
                  >
                    {{ cart.item_count }}
                  </span>
                {%- endif -%}

                <span class="visually-hidden">
                  {{ 'sections.header.cart_count' | t: count: cart.item_count }}
                </span>

              </div>
            {%- endif -%}
          </a>
        </li>

      </ul>
    </nav>
  </header>

  {%- render 'cart-notification', color_scheme: section.settings.color_scheme -%}
</gaia-header>

{%- render 'load-js', script: 'cart-notification.min' -%}

{% javascript %}
  document.addEventListener('DOMContentLoaded', () => {
    let header = document.querySelector('gaia-header');
    let announcement = document.querySelector('.section--announcement-bar');

    function setHeaderHeight() {
      let headerHeight = header
        ? header.getBoundingClientRect().height
        : 0;

      let announcementHeight = 0;

      if (
        announcement &&
        announcement.compareDocumentPosition(header) &
          Node.DOCUMENT_POSITION_FOLLOWING
      ) {
        announcementHeight =
          announcement.getBoundingClientRect().height;
      }

      document.documentElement.style.setProperty(
        '--header-height',
        `${parseInt(headerHeight + announcementHeight)}px`
      );

      document.documentElement.style.setProperty(
        '--header-height-no-announcement',
        `${parseInt(headerHeight)}px`
      );
    }

    setHeaderHeight();

    var headerObserver = new ResizeObserver(setHeaderHeight);

    if (header) {
      headerObserver.observe(header);
    }

    if (announcement) {
      var announcementObserver =
        new ResizeObserver(setHeaderHeight);

      announcementObserver.observe(announcement);
    }
  });
{% endjavascript %}

<script type="application/ld+json">
{
  "@context": "http://schema.org",
  "@type": "Organization",
  "name": "Primal",
  "legalName": "Primal Strength",
  "url": {{ shop.url | json }},

  {% if section.settings.logo %}
    "logo": {{ section.settings.logo | image_url | prepend: "https:" | json }},
  {% elsif shop.logo %}
    "logo": {{ shop.logo | image_url | prepend: "https:" | json }},
  {% endif %}

  "foundingDate": "2016",

  "founder": [
    {
      "@type": "Person",
      "name": "Steven Rinaldi"
    }
  ],

  "alternateName": [
    "Primal Strength"
  ],

  "foundingLocation": "Glasgow, Scotland",

  "areaServed": "United Kingdom",

  "address": {
    "@type": "PostalAddress",
    "streetAddress": {{ shop.address.address1 | json }},
    "addressLocality": {{ shop.address.address2 | json }},
    "addressRegion": {{ shop.address.city | json }},
    "addressCountry": {{ shop.address.country.name | json }},
    "postalCode": {{ shop.address.zip | json }}
  },

  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "Customer Service",
    "telephone": "0808 239 0383",
    "email": "sales@primalstrength.com"
  },

  "sameAs": [
    {{ settings.social_facebook_link | json }},
    {{ settings.social_instagram_link | json }},
    {{ settings.social_linkedin_link | json }},
    {{ settings.social_youtube_link | json }}
  ]
}
</script>

{% schema %}
{
  "name": "Header & Navigation",
  "class": "section-header",
  "tag": "section",

  "settings": [
    {
      "type": "link_list",
      "id": "menu_left",
      "label": "Header Menu"
    },

    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },

    {
      "type": "html",
      "id": "logo_svg",
      "label": "Logo SVG (fallback)"
    },

    {
      "type": "header",
      "content": "Wishlist"
    },

    {
      "type": "checkbox",
      "id": "wishlist",
      "label": "Include wishlist icon?",
      "default": true
    },

    {
      "type": "header",
      "content": "Localisation"
    },

    {
      "type": "checkbox",
      "id": "enable_localisation",
      "label": "Show localisation nav?"
    }
  ]
}
{% endschema %}